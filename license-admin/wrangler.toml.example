name = "jianada-license-admin"
main = "worker/index.js"
compatibility_date = "2026-08-17"

[vars]
ADMIN_USERNAME = "admin"
SESSION_COOKIE_NAME = "ja_admin_session"
ACCOUNT_WHITELIST_PUBLIC_BASE_URL = "https://pub-465f078b4f484662b30eb39d27ae5155.r2.dev/account-whitelist"

# Set these with `wrangler secret put`, not in this file:
# ADMIN_PASSWORD_SHA256
# SESSION_SECRET
# LICENSE_PRIVATE_KEY_PEM

[[d1_databases]]
binding = "DB"
database_name = "jianada-license-admin"
database_id = "replace-with-your-d1-id"

[[r2_buckets]]
binding = "ACCOUNT_WHITELIST_BUCKET"
bucket_name = "pro-downloads"

